    "TrainingPlanComposition": {
      "additionalProperties": false,
      "description": "One entry selected per registry dimension (the architecture doc's registries). Pre-resolution\nintent, dense-default and MoE-compatible - it never assumes dense execution. These are capability\nSELECTIONS (refs into the thin registries), not sealed execution fields; the ``parameters`` block\ncarries the executable knobs and the compatibility pre-check validates the two are consistent.",
      "properties": {
        "checkpoint_strategy": {
          "$ref": "#/$defs/CheckpointImpl",
          "default": "adapter_only"
        },
        "evaluation_profile": {
          "anyOf": [
