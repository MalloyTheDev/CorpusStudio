  "additionalProperties": false,
  "description": "The hash-sealed configuration for a from-scratch / continued PRETRAINING run - the sibling of\n:class:`ResolvedExecutionConfiguration` for the ``pretraining`` execution variant.\n\nThe dense-QLoRA-SFT seal is byte-locked (its own ``configuration_hash`` AND a committed semantic\ngolden), so pretraining semantics live on THIS separate contract, never as new fields on the SFT\nconfig. Unlike SFT/DPO this is a FULL-PARAMETER causal-LM run: there is no adapter, no 4-bit base,\nand no single dataset file. The three input kinds are captured by method sub-specs rather than the\nSFT-shaped ``ExecutionInputs`` (which fail-closed requires one local dataset file + a model-weights\nbinding, neither of which a from-scratch run has): the model by a :class:`ModelInitializationSpec`\n(random from a config, or a continued checkpoint), the tokenizer by a :class:`TokenizerSourceSpec`,\nand the corpus by the sharded :class:`PretrainingDataPolicy`.\n\nCarried on ``RunPlan.resolved_pretraining_execution`` (a plan carries exactly one of the SFT /\npreference / pretraining configs). What remains gated is EXECUTION: the pretraining worker loop\n(``from_config`` init, corpus streaming, packing, per-rank cursor), a workload-verified run, and the\nmilestone wheel that promotes ``pretraining`` to ``workload_verified``. ``trainer_interface`` is an\nexecution-shaped placeholder until that worker seals the exact trainer surface.",
  "properties": {
    "attention": {
      "$ref": "#/$defs/AttentionExecutionPolicy"
    },
    "backend_ref": {
      "$ref": "#/$defs/Ref"
    },
    "batching": {
      "$ref": "#/$defs/BatchingSpec"
    },
    "capability_report_ref": {
      "$ref": "#/$defs/Ref"
    },
    "checkpoint_policy": {
      "$ref": "#/$defs/CheckpointPolicy"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "configuration_id": {
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Configuration Id",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/PretrainingDataPolicy"
    },
    "data_seed": {
      "default": 42,
      "minimum": 0,
      "title": "Data Seed",
      "type": "integer"
    },
    "device_map": {
      "items": {
        "$ref": "#/$defs/DeviceMapEntry"
      },
      "minItems": 1,
      "title": "Device Map",
      "type": "array"
    },
    "environment_binding": {
      "enum": [
        "profile_snapshot",
        "managed_lock"
      ],
      "title": "Environment Binding",
      "type": "string"
    },
    "environment_ref": {
      "$ref": "#/$defs/Ref"
    },
    "export_format": {
      "$ref": "#/$defs/ExportFormat"
    },
    "gradient_checkpointing": {
      "default": true,
      "title": "Gradient Checkpointing",
      "type": "boolean"
    },
    "init": {
      "$ref": "#/$defs/ModelInitializationSpec"
    },
    "loss_impl": {
      "$ref": "#/$defs/LossImpl"
    },
    "objective_ref": {
      "$ref": "#/$defs/Ref"
    },
    "optimizer": {
      "$ref": "#/$defs/OptimizerSpec"
    },
    "output_dir": {
      "minLength": 1,
      "title": "Output Dir",
      "type": "string"
    },
    "output_layout": {
      "const": "run_scoped_v1",
      "default": "run_scoped_v1",
      "title": "Output Layout",
      "type": "string"
    },
    "precision": {
      "$ref": "#/$defs/PrecisionExecutionPolicy"
    },
    "runtime_mode": {
      "enum": [
        "training",
        "cpu_toy"
      ],
      "title": "Runtime Mode",
      "type": "string"
    },
    "schedule": {
      "$ref": "#/$defs/TrainingSchedule"
    },
    "seed": {
      "default": 42,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "sequence": {
