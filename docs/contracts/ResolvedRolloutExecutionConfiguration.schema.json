    "RewardSourceRef": {
      "additionalProperties": false,
      "description": "The hash-pinned reference to what scores each rollout (S5b). A reward model produced by the S5a\nreward vertical is the primary source, served for inference-only scoring; rule / verifier rewards and\nan RLAIF judge (Evaluation Studio's judge under the provider policy) are the declared alternatives.\n``reward_ref`` hash-pins the reward ADAPTER (its safetensors digest) so a run cannot silently swap the\nreward function.\n\nA ``served_reward_model`` additionally seals (a) the LOADABLE identity the worker reconstructs the\nscorer from - ``reward_base_model`` (the base the SEQ_CLS reward adapter sits on) + ``reward_adapter_location``\n(the reward adapter directory) - and (b) ``provenance_manifest_ref``, the reward run's ``RunManifest``\nwhose supervisor-admitted ``reward_success_evidence`` PROVES the source came from a workload_verified\nreward run. The resolver / runner verify that provenance; this contract only requires it be present +\npinned. Non-served kinds leave the served-model fields unset.",
      "properties": {
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "higher_is_better": {
          "default": true,
          "title": "Higher Is Better",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "served_reward_model",
            "verifier",
            "process_reward",
            "rlaif_judge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance_manifest_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reward_adapter_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Adapter Location"
        },
        "reward_base_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Base Model"
        },
        "reward_ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "kind",
        "reward_ref"
      ],
      "title": "RewardSourceRef",
      "type": "object"
    },
    "RolloutSpec": {
      "additionalProperties": false,
      "description": "The GENERATION phase of an on-policy RL run (S5b): how completions are sampled from the current\npolicy to form the experience the update is computed over. Sampling MUST be stochastic (temperature > 0)\n- a greedy rollout collapses the group and yields a zero-variance GRPO advantage. ``rollouts_per_prompt``\nis the GRPO group size (>= 2 so the group-relative advantage is defined). Generation runs on the\nsanctioned worker decode path, never an unsanctioned generation path.",
      "properties": {
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "decode_policy": {
          "const": "sanctioned_worker_decode",
          "default": "sanctioned_worker_decode",
          "title": "Decode Policy",
          "type": "string"
        },
        "max_new_tokens": {
          "minimum": 1,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "rollouts_per_prompt": {
          "minimum": 2,
          "title": "Rollouts Per Prompt",
          "type": "integer"
        },
        "sampling_temperature": {
          "exclusiveMinimum": 0,
          "title": "Sampling Temperature",
          "type": "number"
        },
        "sampling_top_p": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Sampling Top P",
          "type": "number"
        }
      },
      "required": [
        "sampling_temperature",
        "sampling_top_p",
        "max_new_tokens",
        "rollouts_per_prompt"
      ],
      "title": "RolloutSpec",
      "type": "object"
    },
    "SequenceSpec": {
