    "experience",
    "rollout",
    "reward_source",
    "stability",
    "policy_optimization",
    "trainer_interface",
    "export_format",
    "bnb_4bit_use_double_quant",
    "output_dir"
  ],
  "title": "ResolvedRolloutExecutionConfiguration",
  "type": "object"
}
