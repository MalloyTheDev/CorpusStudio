# .NET build output. The WPF/Avalonia desktop prototype's source was removed (#545), but a stale
# bin/obj tree survives in working copies and is NOT a build input: committing it put ~589 MiB of
# .pdb/.exe/.dll into history. Scoped to apps/desktop so a legitimate bin/ or obj/ elsewhere in the
# tree is never hidden.
/apps/desktop/**/bin/
/apps/desktop/**/obj/

# Unsloth writes generated TRL trainer modules here on import; regenerated on demand, never edited.
/unsloth_compiled_cache/

# pytest temp artifacts (basetemp)
.pytmp/
.pytest_tmp/
.pytest-platform/

# coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Claude Code: keep the shared project skill committed, but never the machine-local settings/state.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
engine/.pytest_tmp*/

# Generated run output (containment finding F5): HISTORICAL DEFENSE-IN-DEPTH ONLY. Primary protection
# is now the plan-time containment guard in cli.py (_resolve_sealed_output_root), which defaults the
# sealed output root to the CorpusStudio application-data dir and refuses any root resolving inside the
# checkout. These anchors remain to swallow any legacy/stray in-checkout write, and are anchored to the
# repo root ONLY so a legitimate tracked artifact (e.g.
# examples/wbg/adapter-seq1536-baseline/adapter_model.safetensors) is never hidden.
/output/
/engine/output/
