  "additionalProperties": false,
  "description": "The hash-sealed configuration for an on-policy RL run - the sibling of\n:class:`ResolvedExecutionConfiguration` for the ``on_policy_rl`` execution variant (RL slice S5b,\ngated L1 design #839).\n\nLike the reward seal, it reuses every shared execution sub-spec (placement / precision / attention /\nadapter / optimizer / sequence / batching / checkpoint / schedule / trainer interface) and adds the\non-policy specs: a :class:`RolloutSpec` (generation), an :class:`ExperienceSource` (on-policy prompt\nstream), a :class:`RewardSourceRef` (what scores rollouts), a :class:`StabilityController`\n(KL/entropy/clip), and a :class:`PolicyOptimizationSpec` (GRPO now, PPO in S5c). Unlike reward it\ntrains a CAUSAL_LM POLICY adapter (``adapter_task_type='CAUSAL_LM'``) and exports an ``adapter_peft``\nartifact - a policy, not a score head.\n\nCarried on ``RunPlan.resolved_rollout_execution`` (a plan holds EXACTLY ONE execution config). The\ncontract is the control plane; EXECUTION (the rollout+reward+GRPO worker + a workload-verified run)\nstays gated - ``on_policy_rl`` remains ``contract_validated`` until a measured run promotes it.",
  "properties": {
    "adapter": {
      "$ref": "#/$defs/AdapterSpec"
    },
    "adapter_task_type": {
      "const": "CAUSAL_LM",
      "default": "CAUSAL_LM",
      "title": "Adapter Task Type",
      "type": "string"
    },
    "attention": {
      "$ref": "#/$defs/AttentionExecutionPolicy"
    },
    "backend_ref": {
      "$ref": "#/$defs/Ref"
    },
    "batching": {
      "$ref": "#/$defs/BatchingSpec"
    },
    "bnb_4bit_use_double_quant": {
      "title": "Bnb 4Bit Use Double Quant",
      "type": "boolean"
    },
    "capability_report_ref": {
      "$ref": "#/$defs/Ref"
    },
    "checkpoint_policy": {
      "$ref": "#/$defs/CheckpointPolicy"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "configuration_id": {
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Configuration Id",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data_seed": {
      "default": 42,
      "minimum": 0,
      "title": "Data Seed",
      "type": "integer"
    },
    "device_map": {
      "items": {
        "$ref": "#/$defs/DeviceMapEntry"
      },
      "minItems": 1,
      "title": "Device Map",
      "type": "array"
    },
    "environment_binding": {
      "enum": [
        "profile_snapshot",
        "managed_lock"
      ],
      "title": "Environment Binding",
      "type": "string"
    },
    "environment_ref": {
      "$ref": "#/$defs/Ref"
    },
    "experience": {
      "$ref": "#/$defs/ExperienceSource"
    },
    "export_format": {
      "$ref": "#/$defs/ExportFormat"
    },
    "gradient_checkpointing": {
      "default": true,
      "title": "Gradient Checkpointing",
      "type": "boolean"
    },
    "inputs": {
      "$ref": "#/$defs/ExecutionInputs"
    },
    "objective_ref": {
      "$ref": "#/$defs/Ref"
    },
    "optimizer": {
      "$ref": "#/$defs/OptimizerSpec"
    },
    "output_dir": {
      "minLength": 1,
      "title": "Output Dir",
      "type": "string"
    },
    "output_layout": {
      "const": "run_scoped_v1",
      "default": "run_scoped_v1",
      "title": "Output Layout",
      "type": "string"
    },
    "policy_optimization": {
      "$ref": "#/$defs/PolicyOptimizationSpec"
    },
    "precision": {
      "$ref": "#/$defs/PrecisionExecutionPolicy"
    },
    "reward_source": {
      "$ref": "#/$defs/RewardSourceRef"
    },
    "rollout": {
      "$ref": "#/$defs/RolloutSpec"
    },
    "runtime_mode": {
      "enum": [
        "training",
        "cpu_toy"
      ],
      "title": "Runtime Mode",
      "type": "string"
    },
    "save_strategy": {
      "default": "steps",
      "enum": [
        "no",
        "steps"
      ],
      "title": "Save Strategy",
      "type": "string"
    },
    "schedule": {
      "$ref": "#/$defs/TrainingSchedule"
    },
    "seed": {
      "default": 42,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "sequence": {
      "$ref": "#/$defs/SequenceSpec"
    },
    "stability": {
      "$ref": "#/$defs/StabilityController"
    },
    "trainer_interface": {
      "$ref": "#/$defs/TrainerInterfacePolicy"
    },
    "trust_remote_code": {
      "const": false,
      "default": false,
      "title": "Trust Remote Code",
      "type": "boolean"
    },
    "use_safetensors": {
      "const": true,
      "default": true,
      "title": "Use Safetensors",
      "type": "boolean"
    }
  },
  "required": [
    "configuration_id",
    "configuration_hash",
    "backend_ref",
    "environment_ref",
    "environment_binding",
    "capability_report_ref",
    "inputs",
    "objective_ref",
    "runtime_mode",
    "precision",
