{
  "$defs": {
    "AttentionExecutionPolicy": {
      "additionalProperties": false,
      "description": "Exact model attention API plus the one runtime kernel that is permitted.",
      "properties": {
        "effective_backend_required": {
          "$ref": "#/$defs/AttentionKernel"
        },
        "evidence_kind": {
          "enum": [
            "functional_probe",
            "cpu_reference"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "fallback_policy": {
          "const": "refuse",
          "default": "refuse",
          "title": "Fallback Policy",
          "type": "string"
        },
        "flash_attention_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageLock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flash_sdp_enabled": {
          "title": "Flash Sdp Enabled",
          "type": "boolean"
        },
        "kernel_probe_ref": {
          "$ref": "#/$defs/Ref"
        },
        "math_sdp_enabled": {
          "title": "Math Sdp Enabled",
          "type": "boolean"
        },
        "mem_efficient_sdp_enabled": {
          "title": "Mem Efficient Sdp Enabled",
          "type": "boolean"
        },
        "model_attention_api": {
          "$ref": "#/$defs/ModelAttentionApi"
        },
        "safety_mandate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safety Mandate"
        },
        "verification_requirement": {
          "$ref": "#/$defs/ExecutionVerificationRequirement",
          "default": "require_verified"
        }
      },
      "required": [
        "model_attention_api",
        "effective_backend_required",
        "flash_sdp_enabled",
        "mem_efficient_sdp_enabled",
        "math_sdp_enabled",
        "kernel_probe_ref",
        "evidence_kind"
      ],
      "title": "AttentionExecutionPolicy",
      "type": "object"
    },
    "AttentionKernel": {
      "description": "The exact attention implementation an execution policy permits at runtime.",
      "enum": [
        "eager",
        "torch_sdpa_math",
        "torch_sdpa_flash",
        "torch_sdpa_mem_efficient",
        "flash_attention_2",
        "flash_attention_3",
        "xformers"
      ],
      "title": "AttentionKernel",
      "type": "string"
    },
    "BatchingSpec": {
      "additionalProperties": false,
      "description": "The accumulation TARGET is expressed in SUPERVISED TOKENS, not microbatch count. A\ntoken-target-CAPABLE backend accumulates until summed supervised tokens >= target and normalizes\nthe loss by supervised tokens across the window, so the effective batch is invariant to sequence\nlength + padding. The first-party ``corpus_studio`` reference trainer is NOT token-target-capable\ntoday \u2014 it honors ``fallback_grad_accumulation_steps`` (a fixed microbatch count); the token\ntarget is the contract a future token-aware backend would satisfy.",
      "properties": {
        "fallback_grad_accumulation_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Grad Accumulation Steps"
        },
        "micro_batch_size": {
          "default": 1,
          "minimum": 1,
          "title": "Micro Batch Size",
          "type": "integer"
        },
        "supervised_token_accumulation_target": {
          "minimum": 1,
          "title": "Supervised Token Accumulation Target",
          "type": "integer"
        }
      },
      "required": [
        "supervised_token_accumulation_target"
      ],
      "title": "BatchingSpec",
      "type": "object"
    },
    "CheckpointImpl": {
      "enum": [
        "full_state",
        "adapter_only",
        "sharded",
        "distcp",
        "safetensors"
      ],
      "title": "CheckpointImpl",
      "type": "string"
    },
    "CheckpointPolicy": {
      "additionalProperties": false,
      "properties": {
        "cadence_optimizer_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cadence Optimizer Steps"
        },
        "cadence_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cadence Seconds"
        },
        "impl": {
          "$ref": "#/$defs/CheckpointImpl"
        },
        "keep_last": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep Last"
        },
        "reload_verify": {
          "default": false,
          "title": "Reload Verify",
          "type": "boolean"
        }
      },
      "required": [
        "impl"
      ],
      "title": "CheckpointPolicy",
      "type": "object"
    },
    "CustomModelCodeSpec": {
      "additionalProperties": false,
      "description": "A hash-pinned, ADMITTED local custom-block bundle for a from-scratch run - the mode-3 'your own\nmodel code' path (your own IMPLEMENTATION, the only not-borrowed mode). It seals WHICH exact bytes\n(``code_bundle_ref``) an ADMITTED :class:`ModelCodeVettingReport` (``vetting_ref``) screened, plus the\nentry class + interface. This path NEVER uses HF ``trust_remote_code`` (``Literal[False]``); the\nmodule is loaded locally, by path, from the pinned bundle.\n\nSealing this admits the design AT PLANNING; a static screen is not a safety proof, so EXECUTION stays\ngated behind the (later) worker sandbox exactly as pretraining itself is refused at the worker today.\nBoth refs must be hash-pinned so admission binds to specific bytes and cannot silently re-point.",
      "properties": {
        "code_bundle_ref": {
          "$ref": "#/$defs/Ref"
        },
        "entry_symbol": {
          "minLength": 1,
          "title": "Entry Symbol",
          "type": "string"
        },
        "interface_version": {
          "const": "custom_decoder_v1",
          "title": "Interface Version",
          "type": "string"
        },
        "trust_remote_code": {
          "const": false,
          "default": false,
          "title": "Trust Remote Code",
          "type": "boolean"
        },
        "vetting_ref": {
          "$ref": "#/$defs/Ref"
        },
        "vetting_verdict": {
          "const": "admitted",
          "title": "Vetting Verdict",
          "type": "string"
        }
      },
      "required": [
        "code_bundle_ref",
        "entry_symbol",
        "interface_version",
        "vetting_ref",
        "vetting_verdict"
      ],
      "title": "CustomModelCodeSpec",
      "type": "object"
    },
    "DeviceMapEntry": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minLength": 1,
          "title": "Device",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        }
      },
      "required": [
        "module",
        "device"
      ],
      "title": "DeviceMapEntry",
      "type": "object"
    },
    "ExecutionVerificationRequirement": {
      "description": "Whether the planner may seal a capability that lacks functional evidence.",
      "enum": [
        "require_verified",
        "allow_unverified"
      ],
      "title": "ExecutionVerificationRequirement",
      "type": "string"
    },
    "ExportFormat": {
      "enum": [
        "adapter_peft",
        "reward_model",
        "merged_safetensors",
        "merged_fp16",
        "gguf",
        "onnx",
        "awq",
        "gptq",
        "mlx"
      ],
      "title": "ExportFormat",
      "type": "string"
    },
    "HashRef": {
      "additionalProperties": false,
      "description": "An algorithm-tagged digest. The engine emits sha256 today; the algo tag makes a future\nmigration additive (cf. versions/version_registry.FINGERPRINT_ALGO).",
      "properties": {
        "algo": {
          "default": "sha256",
          "enum": [
            "sha256",
            "sha256-ordered-exact-v1",
            "blake3",
            "none"
          ],
          "title": "Algo",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "HashRef",
      "type": "object"
    },
    "LossImpl": {
      "enum": [
        "cross_entropy",
        "liger_fused_ce",
        "chunked_ce",
        "dpo",
        "orpo",
        "kto",
        "ipo",
        "reward_bt"
      ],
      "title": "LossImpl",
      "type": "string"
    },
    "ModelAttentionApi": {
      "description": "The model-loader API selected before execution.\n\nThis is deliberately separate from :class:`AttentionKernel`: ``sdpa`` is an API that can\ndispatch to several materially different PyTorch kernels.",
      "enum": [
        "eager",
        "sdpa",
        "flash_attention_2",
        "flash_attention_3",
        "xformers"
      ],
      "title": "ModelAttentionApi",
      "type": "string"
    },
    "ModelInitializationSpec": {
      "additionalProperties": false,
      "description": "How a PRETRAINING run instantiates its model. From-scratch has NO source weights: it builds a\nmodel from an architecture config with reproducible random init (the worker's ``from_config`` path,\nnever ``from_pretrained``), pinned by ``architecture_ref`` + ``vocab_size`` + ``init_seed``.\nContinued pretraining loads a hash-pinned ``source_checkpoint_ref`` and states explicitly what is\nreset (optimizer / lr scheduler / data cursor) vs carried. Dense/MoE-safe: this seals init INTENT\nand assumes no dense-specific model shape.",
      "properties": {
        "architecture_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "custom_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomModelCodeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "init_seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Init Seed"
        },
        "initializer_range": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initializer Range"
        },
        "max_position_embeddings": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Position Embeddings"
        },
        "mode": {
          "enum": [
            "random",
            "continued"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reset_data_cursor": {
          "default": true,
          "title": "Reset Data Cursor",
          "type": "boolean"
        },
        "reset_lr_scheduler": {
          "default": true,
          "title": "Reset Lr Scheduler",
          "type": "boolean"
        },
        "reset_optimizer": {
          "default": true,
          "title": "Reset Optimizer",
          "type": "boolean"
        },
        "source_checkpoint_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vocab_size": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocab Size"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ModelInitializationSpec",
      "type": "object"
    },
    "Optimizer": {
      "enum": [
        "adamw_torch",
        "adamw_torch_fused",
        "adamw_8bit",
        "adamw_bnb_8bit",
        "paged_adamw_8bit",
        "paged_adamw_32bit",
        "adafactor",
        "lion",
        "sgd"
      ],
      "title": "Optimizer",
      "type": "string"
    },
    "OptimizerSpec": {
      "additionalProperties": false,
      "properties": {
        "adam_beta1": {
          "default": 0.9,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Adam Beta1",
          "type": "number"
        },
        "adam_beta2": {
          "default": 0.999,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Adam Beta2",
          "type": "number"
        },
        "adam_epsilon": {
          "default": 1e-08,
          "exclusiveMinimum": 0,
          "title": "Adam Epsilon",
          "type": "number"
        },
        "impl": {
          "$ref": "#/$defs/Optimizer"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "lr_scheduler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lr Scheduler"
        },
        "max_grad_norm": {
          "default": 1.0,
          "minimum": 0,
          "title": "Max Grad Norm",
          "type": "number"
        },
        "warmup_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warmup Ratio"
        },
        "weight_decay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Decay"
        }
      },
      "required": [
        "impl",
        "learning_rate"
      ],
      "title": "OptimizerSpec",
      "type": "object"
    },
    "PackageLock": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "record_integrity": {
                "const": "verified"
              }
            },
            "required": [
              "record_integrity"
            ]
          },
          "then": {
            "properties": {
              "hash": {
                "properties": {
                  "algo": {
                    "const": "sha256"
                  },
                  "value": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "value"
                ],
                "type": "object"
              },
              "record_entries": {
                "minimum": 1,
                "type": "integer"
              },
              "record_failed_entries": {
                "maxItems": 0
              },
              "record_verified_entries": {
                "minimum": 1,
                "type": "integer"
              },
              "version": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "version",
              "hash",
              "record_entries",
              "record_verified_entries",
              "record_failed_entries"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "record_count_semantics": {
                "const": "all_record_rows_v2"
              }
            },
            "required": [
              "record_count_semantics"
            ]
          },
          "then": {
            "properties": {
              "installed_file_count": {
                "minimum": 1,
                "type": "integer"
              },
              "installed_files_hash": {
                "properties": {
                  "algo": {
                    "const": "sha256"
                  },
                  "value": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "value"
                ],
                "type": "object"
              },
              "record_integrity": {
                "const": "verified"
              }
            },
            "required": [
              "record_integrity",
              "installed_files_hash",
              "installed_file_count"
            ]
          }
        }
      ],
      "description": "A resolved dependency and its install provenance.\n\n``hash`` seals the installed distribution's RECORD metadata when that evidence is available; it\nis not mislabelled as the original wheel hash. ``direct_url`` and ``artifact`` preserve the\nstronger source identity pip exposes for direct/VCS/local installs. ``dependencies`` is the\ninstalled metadata dependency graph, not a second resolver.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "artifact_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "direct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct"
        },
        "direct_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct Url"
        },
        "editable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Editable"
        },
        "hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "installed_file_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of files sealed by installed_files_hash; equals record_entries when record_integrity is verified.",
          "title": "Installed File Count"
        },
        "installed_files_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "installer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "normalized_name": {
          "default": "",
          "title": "Normalized Name",
          "type": "string"
        },
        "record_count_semantics": {
          "anyOf": [
            {
              "const": "all_record_rows_v2",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit all-RECORD-row count meaning. Missing means preserved legacy hash-bearing-row counts and is not admissible for new health, planning, or execution.",
          "title": "Record Count Semantics"
        },
        "record_entries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of regular installed files named by the distribution RECORD; positive when record_integrity is verified.",
          "title": "Record Entries"
        },
        "record_failed_entries": {
          "items": {
            "type": "string"
          },
          "title": "Record Failed Entries",
          "type": "array"
        },
        "record_integrity": {
          "default": "unknown",
          "enum": [
            "verified",
            "failed",
            "missing",
            "unknown"
          ],
          "title": "Record Integrity",
          "type": "string"
        },
        "record_verified_entries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verified row count under record_count_semantics; manager <=1.2 counted only hash-bearing rows, while all_record_rows_v2 equals record_entries.",
          "title": "Record Verified Entries"
        },
        "requested": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested"
        },
        "source": {
          "default": "unknown",
          "enum": [
            "pypi",
            "wheel",
            "sdist",
            "conda",
            "vcs",
            "local",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_evidence_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Evidence Reason"
        },
        "source_index_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Index Url"
        },
        "vcs_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vcs Commit"
        },
        "vcs_repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vcs Repository"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "PackageLock",
      "type": "object"
    },
    "PrecisionExecutionPolicy": {
      "additionalProperties": false,
      "description": "The numerical representation of each material training state.\n\n``weight_storage_dtype`` describes an unquantized frozen base; quantized bases use\n``quantized_storage_format`` instead. ``master_weight_dtype`` describes the trainable adapter\nparameters. An 8-bit optimizer may use quantized primary state plus FP32 auxiliary tensors.",
      "properties": {
        "dequantization_dtype": {
          "$ref": "#/$defs/PrecisionMode"
        },
        "forward_compute_dtype": {
          "$ref": "#/$defs/PrecisionMode"
        },
        "gradient_dtype": {
          "$ref": "#/$defs/PrecisionMode"
        },
        "master_weight_dtype": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "optimizer_auxiliary_dtype": {
          "$ref": "#/$defs/PrecisionMode",
          "default": "fp32"
        },
        "optimizer_state_dtype": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionMode"
            },
            {
              "$ref": "#/$defs/QuantizationMode"
            }
          ],
          "title": "Optimizer State Dtype"
        },
        "quantized_storage_format": {
          "$ref": "#/$defs/QuantizationMode",
          "default": "none"
        },
        "weight_storage_dtype": {
