    "PolicyOptimizationSpec": {
      "additionalProperties": false,
      "description": "The on-policy optimization algorithm (S5b). GRPO (group-relative advantage) needs NO critic - it is\nthe cheaper shape that fits the 12 GB envelope like DPO/reward did; PPO (a clipped surrogate with a\nvalue head) is the S5c follow-up. The reference model is the frozen base reached via\n``disable_adapter`` (the DPO pattern), so no separate reference weights are stored.",
      "properties": {
        "algorithm": {
          "default": "grpo",
          "enum": [
            "grpo",
            "ppo"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
