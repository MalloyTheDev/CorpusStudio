    "TrainingPlanParameters": {
      "additionalProperties": false,
      "description": "The free (numeric / identity) knobs of a training run - a serializable mirror of the planner's\n``PlannerConstraints`` user intent. The resolver lowers these verbatim into a RunPlan, so this is\nthe executable-knob source of truth; the registry SELECTIONS in ``TrainingPlanComposition`` are the\nhigher-level capability view. A drift test keeps this mirror field-for-field with\n``PlannerConstraints`` so the resolver can reproduce a direct build's ``plan_hash`` exactly.",
      "properties": {
        "adam_beta1": {
          "default": 0.9,
          "title": "Adam Beta1",
          "type": "number"
        },
        "adam_beta2": {
          "default": 0.999,
